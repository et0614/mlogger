<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="ForestGreen">ForestGreen</Color> <!--#228B22-->
    <Color x:Key="DarkGreen">DarkGreen</Color> <!--#006400-->
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>

    <Color x:Key="Darkest_G">#155915</Color>
    <Color x:Key="Dark_G">#1B5E20</Color>  <!-- Material Green 900。旧 ForestGreen (#228B22) より深く、白背景での小文字 contrast を AA 達成 -->
    <Color x:Key="Light_G">#C8FFC8</Color>
    <Color x:Key="Lightest_G">#F5FFF5</Color>

    <!-- 計測値の semantic 色 (緑基調アプリでも警告/危険は補色寄りで強調).
         DataReceiveViewModel が Application.Current.Resources から取得して
         VelocityColor / Co2Color / WbgtIndoorColor / WbgtOutdoorColor binding に流す。-->
    <Color x:Key="Status_Normal">#1B5E20</Color>  <!-- = Dark_G、通常時 -->
    <Color x:Key="Status_Warn">#EF6C00</Color>    <!-- Material Orange 900、警戒 -->
    <Color x:Key="Status_Danger">#C62828</Color>  <!-- Material Red 800、危険 -->
    <SolidColorBrush x:Key="Status_NormalBrush" Color="{StaticResource Status_Normal}"/>
    <SolidColorBrush x:Key="Status_WarnBrush"   Color="{StaticResource Status_Warn}"/>
    <SolidColorBrush x:Key="Status_DangerBrush" Color="{StaticResource Status_Danger}"/>

    <!-- ダークモード用の色 (Styles.xaml と各画面の AppThemeBinding の Dark= 側で使う)。
         緑の基調は保ち、暗い背景で読めるよう前景の緑・警告色は明るめにする。
         コードから使う色は MLUtility.ThemeColor("キー") で、ダーク時は "キー_Dark" を引く。 -->
    <Color x:Key="PageBg_Dark">#121812</Color>       <!-- ページの背景 (ライト: Lightest_G) -->
    <Color x:Key="Surface_Dark">#1E261E</Color>      <!-- 行・入力欄・カード (ライト: White) -->
    <Color x:Key="Text_Dark">#E6EEE6</Color>         <!-- 本文の文字 (ライト: Black) -->
    <Color x:Key="Accent_Dark">#81C784</Color>       <!-- 見出し・アイコン・枠線の緑 (ライト: Dark_G) -->
    <Color x:Key="Selected_Dark">#2E4A2E</Color>     <!-- 選択中・ボタンの地 (ライト: Light_G) -->
    <Color x:Key="Line_Dark">#2E4A2E</Color>         <!-- 区切り線 (ライト: Darkest_G) -->
    <Color x:Key="Bar_Dark">#123D16</Color>          <!-- 上部のバーと下のタブ (ライト: Darkest_G)。暗い画面で重く見えないよう暗めの緑 -->
    <Color x:Key="Heading_Dark">#5E9E62</Color>      <!-- 機器設定の見出し (ロギング先など)。Accent_Dark より控えめ -->
    <Color x:Key="Status_Normal_Dark">#81C784</Color>
    <Color x:Key="Status_Warn_Dark">#FFA726</Color>
    <Color x:Key="Status_Danger_Dark">#EF5350</Color>

    <!-- コードから色を付ける箇所の、ライト/ダークの組 -->
    <Color x:Key="Surface">White</Color>
    <Color x:Key="Text">Black</Color>
    <Color x:Key="DumpRow">#E3F2FD</Color>           <!-- 内蔵メモリから取り出したデータの行 -->
    <Color x:Key="DumpRow_Dark">#1A2A3A</Color>
    <Color x:Key="Link">#1976D2</Color>
    <Color x:Key="Link_Dark">#64B5F6</Color>

    <Color x:Key="Darkest_O">#804d00</Color>
    <Color x:Key="Dark_O">#e68a00</Color>
    <Color x:Key="Light_O">#ffd699</Color>
    <Color x:Key="Lightest_O">#fff5e6</Color>

    <Color x:Key="Primary">ForestGreen</Color>
    <Color x:Key="Secondary">#DFD8F7</Color>
    <Color x:Key="Tertiary">#2B0B98</Color>
    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

    <Color x:Key="Yellow100Accent">#F7B548</Color>
    <Color x:Key="Yellow200Accent">#FFD590</Color>
    <Color x:Key="Yellow300Accent">#FFE5B9</Color>
    <Color x:Key="Cyan100Accent">#28C2D1</Color>
    <Color x:Key="Cyan200Accent">#7BDDEF</Color>
    <Color x:Key="Cyan300Accent">#C3F2F4</Color>
    <Color x:Key="Blue100Accent">#3E8EED</Color>
    <Color x:Key="Blue200Accent">#72ACF1</Color>
    <Color x:Key="Blue300Accent">#A7CBF6</Color>

</ResourceDictionary>