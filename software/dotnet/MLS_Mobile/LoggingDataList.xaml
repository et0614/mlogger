<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MLS_Mobile.LoggingDataList"
             xmlns:res="clr-namespace:MLS_Mobile.Resources.i18n"
             Title="{x:Static res:MLSResource.LD_List}"
             >

    <ContentPage.ToolbarItems>
        <!--複数のファイルを選んで一括削除するための選択モード切り替え-->
        <ToolbarItem x:Name="selectToolbarItem" Text="{x:Static res:MLSResource.LD_Select}" Clicked="select_Clicked"/>
    </ContentPage.ToolbarItems>

    <StackLayout>
        
        <!--スクロールする計測データリスト-->
        <CollectionView Grid.Row="0" Grid.Column="0" x:Name="fileList" IsGrouped="true" ItemsSource="{Binding LogFiles}" Margin="0,0,0,0"
                        SelectionMode="None" VerticalScrollBarVisibility="Always" VerticalOptions="FillAndExpand">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView Margin="0,2,0,2" BackgroundColor="{AppThemeBinding Light={StaticResource Lightest_G}, Dark={StaticResource PageBg_Dark}}">
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem Text="{x:Static res:MLSResource.LD_Delete}"
                                           BackgroundColor="{StaticResource Status_Danger}"
                                           Command="{Binding DeleteCommand}"
                                           CommandParameter="{Binding .}">
                                    <SwipeItem.IconImageSource>
                                        <FontImageSource Glyph="&#xf2ed;" FontFamily="FAR" Size="16" Color="White"/>
                                    </SwipeItem.IconImageSource>
                                </SwipeItem>
                                <SwipeItem Text="{x:Static res:MLSResource.LD_Share}"
                                           BackgroundColor="{StaticResource Dark_G}"
                                           Command="{Binding ShareCommand}"
                                           CommandParameter="{Binding .}">
                                    <SwipeItem.IconImageSource>
                                        <FontImageSource Glyph="&#xe09a;" FontFamily="FAS" Size="16" Color="White"/>
                                    </SwipeItem.IconImageSource>
                                </SwipeItem>
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border Margin="20,0,20,0" Stroke="{AppThemeBinding Light={StaticResource Dark_G}, Dark={StaticResource Accent_Dark}}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                            <Grid Padding="5"
                              RowDefinitions="Auto"
                              ColumnDefinitions="Auto, Auto, *"
                              RowSpacing="5"
                              ColumnSpacing="5"
                              BackgroundColor="{Binding RowBackgroundColor}">

                                <!--選択モードのときだけ表示するチェックボックス-->
                                <CheckBox Grid.Row="0" Grid.Column="0"
                               IsVisible="{Binding IsSelecting}"
                               IsChecked="{Binding IsSelected, Mode=TwoWay}"
                               Color="{AppThemeBinding Light={StaticResource Dark_G}, Dark={StaticResource Accent_Dark}}"
                               VerticalOptions="Center"/>
                                <Label Grid.Row="0" Grid.Column="1"
                               Text="{Binding Path=DTimeDisplay}"
                               FontSize="18" Padding="10,5"
                               HorizontalOptions="Start" VerticalOptions="Center"/>
                                <Label Grid.Row="0" Grid.Column="2"
                               Text="{Binding Path=FileSize, StringFormat='{0} bytes'}" 
                               FontSize="16" Padding="10,5"
                               HorizontalTextAlignment="Start"
                               HorizontalOptions="FillAndExpand" VerticalOptions="Center"
                               TextColor="Gray"/>
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <VerticalStackLayout>
                        <Label Text="{Binding MLoggerName}"
                           TextColor="{AppThemeBinding Light={StaticResource Darkest_G}, Dark={StaticResource Accent_Dark}}"
                           BackgroundColor="Transparent"
                           FontSize="20"
                           FontAttributes="Bold" Padding="10,15,10,5" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.EmptyView>
                <Grid 
                    Padding="5" 
                    RowDefinitions="Auto, *"
                    ColumnDefinitions="*" 
                    RowSpacing="5"
                    ColumnSpacing="5">
                    <Label 
                        Grid.Row="0" Grid.Column="0"
                        Text="{x:Static res:MLSResource.LD_NoData}" 
                        FontSize="18"
                        HorizontalOptions="Start"
                        VerticalOptions="Center" Padding="5"/>
                </Grid>
            </CollectionView.EmptyView>
        </CollectionView>
        
        <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource Darkest_G}, Dark={StaticResource Line_Dark}}" HorizontalOptions="FillAndExpand" />

        <!--選択モードのときの操作 (すべて選択 / 選択したファイルを削除)-->
        <Grid x:Name="selectionBar" IsVisible="False" ColumnDefinitions="*, *" ColumnSpacing="10" Margin="10">
            <Button Grid.Column="0" Text="{x:Static res:MLSResource.LD_SelectAll}" Clicked="selectAll_Clicked"/>
            <Button Grid.Column="1" x:Name="deleteSelectedButton" Clicked="deleteSelected_Clicked"
                    BackgroundColor="{StaticResource Status_Danger}" TextColor="White"/>
        </Grid>

        <!--ログデータ閲覧ボタン-->
        <Button x:Name="logButton" Text="{x:Static res:MLSResource.LD_ViewLog}" Margin="10" VerticalOptions="Center" HorizontalOptions="Fill" Clicked="log_Clicked" ContentLayout="Left, 20">
            <Button.ImageSource>
                <FontImageSource Glyph="&#xf15c;" FontFamily="FAS" Size="20" Color="{AppThemeBinding Light={StaticResource Dark_G}, Dark={StaticResource Accent_Dark}}"/>
            </Button.ImageSource>
        </Button>

    </StackLayout>

</ContentPage>
