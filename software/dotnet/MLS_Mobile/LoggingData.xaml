<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MLS_Mobile.LoggingData"
             xmlns:res="clr-namespace:MLS_Mobile.Resources.i18n"
             Title="{x:Static res:MLSResource.LD_Title}">

    <Grid Margin="0" RowDefinitions="60,*" ColumnDefinitions="*,*">

        <!--共有ボタン-->
        <Button Grid.Row="0" Grid.Column="0" Text="{x:Static res:MLSResource.LD_Share}" Clicked="share_Clicked" ContentLayout="Left, 10" Margin="5">
            <Button.ImageSource>
                <FontImageSource Glyph="&#xe09a;" FontFamily="FAS" Size="24" Color="{AppThemeBinding Light={StaticResource Dark_G}, Dark={StaticResource Accent_Dark}}"/>
            </Button.ImageSource>
        </Button>

        <!--削除ボタン-->
        <Button Grid.Row="0" Grid.Column="1" Text="{x:Static res:MLSResource.LD_Delete}" Clicked="delete_Clicked" ContentLayout="Left, 10" Margin="5">
            <Button.ImageSource>
                <FontImageSource Glyph="&#xf2ed;" FontFamily="FAR" Size="24" Color="{AppThemeBinding Light={StaticResource Dark_G}, Dark={StaticResource Accent_Dark}}"/>
            </Button.ImageSource>
        </Button>

        <!--データテーブル表示-->
        <ScrollView Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="5" Orientation="Both" HorizontalScrollBarVisibility="Always" VerticalScrollBarVisibility="Always">
            <Grid Padding="1" x:Name="tableGrid" RowDefinitions="60,Auto" BackgroundColor="{StaticResource Dark_G}" ColumnDefinitions="80,80,80,80,80,80,80,80"/>
        </ScrollView>

        <!--インジケータ-->
        <ContentView x:Name="grayback" IsVisible="False" BackgroundColor="Black" Opacity="0.4" Grid.RowSpan="3" Grid.ColumnSpan="3"/>
        <Border x:Name="indicator" IsVisible="False" BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Surface_Dark}}" Grid.RowSpan="3" Grid.ColumnSpan="3" AnchorX="0.5" HorizontalOptions="Center" VerticalOptions="Center" StrokeShape="RoundRectangle 10" Padding="15">
            <StackLayout BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Surface_Dark}}">
                <ActivityIndicator Color="{AppThemeBinding Light=Black, Dark={StaticResource Text_Dark}}" IsRunning="True"/>
                <Label x:Name="indicatorLabel" Text="---" TextColor="{AppThemeBinding Light=Black, Dark={StaticResource Text_Dark}}"/>
            </StackLayout>
        </Border>
        <!--インジケータここまで-->
    </Grid>
</ContentPage>
